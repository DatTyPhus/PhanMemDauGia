<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800" prefWidth="1400" style="-fx-background-color: #f1f5f9;" stylesheets="@sidebar.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.AuctionHistoryController">

    <top>
        <HBox alignment="CENTER_LEFT" minHeight="90.0" prefHeight="90.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 5);" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="30.0" right="40.0" />
            </padding>
            <BorderPane.margin>
                <Insets left="196.0" />
            </BorderPane.margin>
            <children>
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0B1F3A; -fx-letter-spacing: 1;" text="LỊCH SỬ ĐẤU GIÁ" />
                    <HBox alignment="CENTER_LEFT" spacing="5">
                        <Label style="-fx-text-fill: #3b82f6; -fx-font-weight: bold; -fx-font-size: 13;" text="HOẠT ĐỘNG" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 13;" text=" | Theo dõi chi tiết các phiên bạn đã tham gia" />
                    </HBox>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER" spacing="15" style="-fx-background-color: #f8fafc; -fx-padding: 8 20; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12;">
                    <children>
                        <VBox alignment="CENTER_RIGHT" spacing="2">
                            <Label fx:id="lblUserName" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Tên Người Dùng" />
                            <HBox alignment="CENTER_RIGHT" spacing="8">
                                <Label fx:id="lblTopBalance" style="-fx-text-fill: #10b981; -fx-font-weight: bold; -fx-font-size: 12;" text="Số dư: 0 VNĐ" />
                                <Label fx:id="lblUserRole" style="-fx-font-size: 11; -fx-font-weight: 800; -fx-text-fill: #3b82f6; -fx-background-color: #dbeafe; -fx-padding: 2 8; -fx-background-radius: 4;" text="ROLE" />
                            </HBox>
                        </VBox>
                        <StackPane prefHeight="45" prefWidth="45" style="-fx-background-color: #3b82f6; -fx-background-radius: 10;">
                            <children>
                                <Label style="-fx-font-size: 22; -fx-text-fill: white;" text="👤" />
                            </children>
                        </StackPane>
                    </children>
                </HBox>
            </children>
        </HBox>
    </top>
    <left>
        <VBox prefHeight="700.0" prefWidth="196.0" style="-fx-background-color: #0B1F3A;" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="196.0">
                    <children>
                  <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../image/54699acc-6fba-4ff0-b214-6edb30950a28.png" />
                     </image>
                  </ImageView>
                        <VBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="120.0">
                            <children>
                                <Label style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;" text="ĐẤU GIÁ" />
                                <Label style="-fx-text-fill: white; -fx-font-size: 14;" text="TRỰC TUYẾN" />
                            </children>
                            <HBox.margin><Insets left="10.0" /></HBox.margin>
                        </VBox>
                    </children>
                    <VBox.margin><Insets bottom="20.0" top="15.0" /></VBox.margin>
                </HBox>

                <Button mnemonicParsing="false" onAction="#onBackToHomeClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Trang chủ">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>
                <Button mnemonicParsing="false" onAction="#onAuctionSessionClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Phiên đấu giá">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>
                <Button mnemonicParsing="false" onAction="#onProductManagementClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Quản lý tài sản">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>
                <Button maxWidth="250.0" mnemonicParsing="false" styleClass="nav-btn-active" text="Lịch sử đấu giá">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>
                <Button mnemonicParsing="false" onAction="#onNotificationClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Thông báo">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>
                <Button mnemonicParsing="false" onAction="#onProfileClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Hồ sơ của tôi">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>
                <Button mnemonicParsing="false" onAction="#onSettingClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Cài đặt">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>
            </children>
            <BorderPane.margin>
                <Insets top="-90.0" />
            </BorderPane.margin>
        </VBox>
    </left>

    <center>
        <VBox spacing="25" style="-fx-background-color: linear-gradient(to bottom right, #ffffff 0%, #f1f5f9 40%, #e2e8f0 100%);">
            <padding>
                <Insets bottom="30" left="35" right="35" top="35" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: white; -fx-padding: 15 25; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 3);">

                <TextField prefHeight="40" prefWidth="300" promptText="🔍 Tìm kiếm tên tài sản..." style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8;" />

                <ComboBox prefHeight="40" prefWidth="160" promptText="Trạng thái" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8;" />

                <Button prefHeight="40" style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 0 20; -fx-cursor: hand;" text="Lọc Dữ Liệu" />

                <Region HBox.hgrow="ALWAYS" />

                <Button prefHeight="40" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 0 20; -fx-cursor: hand;" text="⬇ Xuất Excel" />
            </HBox>

            <VBox style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);" VBox.vgrow="ALWAYS">
                <children>
                    <TableView fx:id="historyTable" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn prefWidth="90" style="-fx-alignment: CENTER;" text="Mã Phiên" />
                            <TableColumn prefWidth="280" style="-fx-alignment: CENTER_LEFT; -fx-font-weight: bold;" text="Tên tài sản đấu giá" />
                            <TableColumn prefWidth="160" style="-fx-alignment: CENTER_RIGHT; -fx-text-fill: #0f172a;" text="Mức giá bạn đặt" />
                            <TableColumn prefWidth="160" style="-fx-alignment: CENTER_RIGHT; -fx-text-fill: #059669; -fx-font-weight: bold;" text="Giá chốt cuối cùng" />
                            <TableColumn prefWidth="180" style="-fx-alignment: CENTER;" text="Thời gian tham gia" />
                            <TableColumn prefWidth="150" style="-fx-alignment: CENTER;" text="Kết quả" />
                            <TableColumn prefWidth="120" style="-fx-alignment: CENTER;" text="Thao tác" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </children>
            </VBox>

            <HBox alignment="CENTER" prefHeight="40">
                <Pagination fx:id="pagination" maxPageIndicatorCount="5" prefWidth="400" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
