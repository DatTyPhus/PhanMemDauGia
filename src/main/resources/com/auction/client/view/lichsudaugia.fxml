<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="820" prefWidth="1400" style="-fx-background-color: #f1f5f9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">

    <!-- ================= HEADER ================= -->
    <left>
      <VBox prefHeight="323.0" prefWidth="196.0" style="-fx-background-color: #0B1F3A;" BorderPane.alignment="CENTER">
         <children>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Label style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;" text="🔨">
                     <HBox.margin>
                        <Insets left="17.0" top="78.0" />
                     </HBox.margin></Label>
                  <VBox prefHeight="200.0" prefWidth="100.0">
                     <children>
                        <Label style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;" text="ĐẤU GIÁ">
                           <VBox.margin>
                              <Insets left="-22.0" top="19.0" />
                           </VBox.margin>
                        </Label>
                        <Label style="-fx-text-fill: white; -fx-background-color: transparent; -fx-font-size: 14;" text="TRỰC TUYẾN">
                           <VBox.margin>
                              <Insets left="-24.0" top="2.0" />
                           </VBox.margin>
                        </Label>
                     </children>
                     <HBox.margin>
                        <Insets bottom="44.0" left="35.0" top="50.0" />
                     </HBox.margin>
                     <padding>
                        <Insets left="9.0" />
                     </padding>
                  </VBox>
               </children>
               <VBox.margin>
                  <Insets bottom="-34.0" top="-4.0" />
               </VBox.margin>
            </HBox>
            <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Trang chủ">
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin></Button>
            <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Phiên đấu giá" />
            <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Tài sản đấu giá" />
            <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Lịch sử đấu giá" />
            <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Thông báo" />
            <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Hồ sơ của tôi" />
            <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Cài đặt" />
         </children>
         <BorderPane.margin>
            <Insets top="-204.0" />
         </BorderPane.margin>
      </VBox>
   </left>
    <top>
        <VBox spacing="15" style="-fx-background-color: white;                      -fx-padding: 20 30;                      -fx-border-color: #e2e8f0;                      -fx-border-width: 0 0 1 0;">

            <!-- Title -->
            <HBox alignment="CENTER_LEFT">

                <VBox spacing="5">
                    <Label style="-fx-font-size: 30px;                                   -fx-font-weight: bold;                                   -fx-text-fill: #0f172a;" text="Lịch sử đấu giá" />

                    <Label style="-fx-text-fill: #64748b;                                   -fx-font-size: 14px;" text="Theo dõi toàn bộ hoạt động đấu giá của bạn" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <Button prefHeight="40" style="-fx-background-color: #2563eb;                                -fx-text-fill: white;                                -fx-background-radius: 10;                                -fx-font-weight: bold;" text="⬇ Xuất Excel" />
            </HBox>

            <!-- Filter -->
            <HBox spacing="15">

                <TextField prefHeight="40" prefWidth="280" promptText="Tìm kiếm sản phẩm..." style="-fx-background-radius: 10;" />

                <ComboBox prefHeight="40" prefWidth="180" promptText="Trạng thái" />

                <DatePicker prefHeight="40" />

                <Button prefHeight="40" prefWidth="120" style="-fx-background-color: #0f172a;                                -fx-text-fill: white;                                -fx-background-radius: 10;" text="Lọc" />

            </HBox>
         <BorderPane.margin>
            <Insets left="199.0" />
         </BorderPane.margin>
        </VBox>
    </top>

