        <VBox spacing="25" style="-fx-padding: 25;">

            <!-- ================= STATS ================= -->
            <HBox spacing="20">

                <!-- Card -->
                <VBox prefWidth="250" spacing="10" style="-fx-background-color: white;                              -fx-padding: 22;                              -fx-background-radius: 18;">

                    <Label style="-fx-text-fill: #64748b;" text="Tổng phiên tham gia" />

                    <Label style="-fx-font-size: 34px;                                   -fx-font-weight: bold;" text="156" />
                </VBox>

                <!-- Card -->
                <VBox prefWidth="250" spacing="10" style="-fx-background-color: white;                              -fx-padding: 22;                              -fx-background-radius: 18;">

                    <Label style="-fx-text-fill: #64748b;" text="Phiên thắng" />

                    <Label style="-fx-font-size: 34px;                                   -fx-font-weight: bold;                                   -fx-text-fill: #16a34a;" text="28" />
                </VBox>

                <!-- Card -->
                <VBox prefWidth="300" spacing="10" style="-fx-background-color: white;                              -fx-padding: 22;                              -fx-background-radius: 18;">

                    <Label style="-fx-text-fill: #64748b;" text="Tổng chi tiêu" />

                    <Label style="-fx-font-size: 30px;                                   -fx-font-weight: bold;                                   -fx-text-fill: #2563eb;" text="1.240.000.000đ" />
                </VBox>

                <!-- Card -->
                <VBox prefWidth="250" spacing="10" style="-fx-background-color: white;                              -fx-padding: 22;                              -fx-background-radius: 18;">

                    <Label style="-fx-text-fill: #64748b;" text="Đang tham gia" />

                    <Label style="-fx-font-size: 34px;                                   -fx-font-weight: bold;                                   -fx-text-fill: #f59e0b;" text="12" />
                </VBox>

            </HBox>

            <!-- ================= TABLE ================= -->
            <VBox spacing="20" style="-fx-background-color: white;                          -fx-background-radius: 22;                          -fx-padding: 22;" VBox.vgrow="ALWAYS">

                <!-- Table Header -->
                <HBox alignment="CENTER_LEFT">

                    <Label style="-fx-font-size: 22px;                                   -fx-font-weight: bold;" text="Danh sách lịch sử" />

                    <Region HBox.hgrow="ALWAYS" />

                    <Button style="-fx-background-color: #e2e8f0;                                    -fx-background-radius: 10;" text="Làm mới" />
                </HBox>

                <!-- Table -->
                <TableView style="-fx-background-radius: 18;" VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn prefWidth="80" text="ID" />

                        <TableColumn prefWidth="280" text="Tên sản phẩm" />

                        <TableColumn prefWidth="180" text="Giá của bạn" />

                        <TableColumn prefWidth="180" text="Giá cuối" />

                        <TableColumn prefWidth="200" text="Thời gian" />

                        <TableColumn prefWidth="180" text="Trạng thái" />

                        <TableColumn prefWidth="160" text="Chi tiết" />

                    </columns>

                </TableView>

                <!-- Pagination -->
                <HBox alignment="CENTER" spacing="10">
               <Pagination prefHeight="200.0" prefWidth="200.0" />

                </HBox>

            </VBox>

            <!-- ================= ACTIVITY ================= -->
            <VBox spacing="18" style="-fx-background-color: white;                          -fx-background-radius: 22;                          -fx-padding: 22;">

                <Label style="-fx-font-size: 22px;                               -fx-font-weight: bold;" text="Hoạt động gần đây" />

                <!-- Item -->
                <HBox alignment="CENTER_LEFT" spacing="15">

                    <Circle radius="8" style="-fx-fill: #16a34a;" />

                    <VBox spacing="4">

                        <Label style="-fx-font-weight: bold;                                       -fx-font-size: 15px;" text="Bạn đã thắng phiên đấu giá Rolex Submariner" />

                        <Label style="-fx-text-fill: gray;                                       -fx-font-size: 12px;" text="10 phút trước" />
                    </VBox>

                </HBox>

                <!-- Item -->
                <HBox alignment="CENTER_LEFT" spacing="15">

                    <Circle radius="8" style="-fx-fill: #f59e0b;" />

                    <VBox spacing="4">

                        <Label style="-fx-font-weight: bold;                                       -fx-font-size: 15px;" text="Bạn vừa đặt giá mới cho MacBook Pro M3" />

                        <Label style="-fx-text-fill: gray;                                       -fx-font-size: 12px;" text="30 phút trước" />
                    </VBox>

                </HBox>

                <!-- Item -->
                <HBox alignment="CENTER_LEFT" spacing="15">

                    <Circle radius="8" style="-fx-fill: #ef4444;" />

                    <VBox spacing="4">

                        <Label style="-fx-font-weight: bold;                                       -fx-font-size: 15px;" text="Bạn đã bị vượt giá ở iPhone 15 Pro Max" />

                        <Label style="-fx-text-fill: gray;                                       -fx-font-size: 12px;" text="1 giờ trước" />
                    </VBox>

                </HBox>

            </VBox>

        </VBox>

    </center>

</BorderPane>
