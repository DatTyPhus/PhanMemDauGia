<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800" prefWidth="1400" style="-fx-background-color: #f1f5f9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.HomeController">

    <top>
        <HBox alignment="CENTER_LEFT" minHeight="90.0" prefHeight="90.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 5);" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="30.0" right="40.0" />
            </padding>
            <BorderPane.margin>
                <Insets left="196.0" />
            </BorderPane.margin>
            <children>
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0B1F3A; -fx-letter-spacing: 1;" text="HỆ THỐNG ĐẤU GIÁ" />
                    <HBox alignment="CENTER_LEFT" spacing="5">
                        <Label style="-fx-text-fill: #22c55e; -fx-font-weight: bold; -fx-font-size: 13;" text="● LIVE" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 13;" text=" | Sàn giao dịch tài sản trực tuyến" />
                    </HBox>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER" spacing="15" style="-fx-background-color: #f8fafc; -fx-padding: 8 20; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12;">
                    <children>
                        <VBox alignment="CENTER_RIGHT">
                            <Label fx:id="lblUserName" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Nguyễn Tiến Đạt" />
                            <Label fx:id="lblUserRole" style="-fx-font-size: 11; -fx-font-weight: 800; -fx-text-fill: #3b82f6; -fx-background-color: #dbeafe; -fx-padding: 2 8; -fx-background-radius: 4;" text="SELLER" />
                        </VBox>
                        <StackPane prefHeight="45" prefWidth="45" style="-fx-background-color: #3b82f6; -fx-background-radius: 10;">
                            <children>
                                <Label style="-fx-font-size: 22; -fx-text-fill: white;" text="👤" />
                            </children>
                        </StackPane>
                    </children>
                </HBox>
            </children>
        </HBox>
    </top>

    <left>
        <VBox prefHeight="700.0" prefWidth="196.0" style="-fx-background-color: #0B1F3A;" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="196.0">
                    <children>
                        <Label style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" text="🔨">
                            <HBox.margin>
                                <Insets left="15.0" />
                            </HBox.margin>
                        </Label>
                        <VBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="120.0">
                            <children>
                                <Label style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;" text="ĐẤU GIÁ" />
                                <Label style="-fx-text-fill: white; -fx-font-size: 14;" text="TRỰC TUYẾN" />
                            </children>
                            <HBox.margin>
                                <Insets left="10.0" />
                            </HBox.margin>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets bottom="20.0" top="15.0" />
                    </VBox.margin>
                </HBox>

                <Button onAction="#onBackToHomeClick" mnemonicParsing="false" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 8;" text="Trang chủ">
                    <VBox.margin><Insets left="8" right="8"/></VBox.margin>
                </Button>
                <Button onAction="#onAuctionSessionClick" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Phiên đấu giá" />
                <Button onAction="#onProductManagementClick" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Quản lý tài sản" />
                <Button onAction="#onHistoryClick" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Lịch sử đấu giá" />
                <Button onAction="#onNotificationClick" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Thông báo" />
                <Button onAction="#onProfileClick" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Hồ sơ của tôi" />
                <Button onAction="#onSettingClick" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Cài đặt" />
            </children>

            <BorderPane.margin>
                <Insets top="-90.0" />
            </BorderPane.margin>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: linear-gradient(to bottom right, #ffffff 0%, #f8fafc 30%, #e0e7ff 70%, #dbeafe 100%);">
            <content>
                <VBox spacing="30">
                    <padding>
                        <Insets bottom="35" left="35" right="35" top="35" />
                    </padding>
                    <children>

                        <HBox spacing="25" alignment="CENTER">
                            <children>
                                <HBox HBox.hgrow="ALWAYS" prefHeight="110" spacing="20" alignment="CENTER_LEFT"
                                      style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 15, 0, 0, 5);">
                                    <children>
                                        <StackPane prefHeight="60" prefWidth="60" style="-fx-background-color: #e0f2fe; -fx-background-radius: 14;">
                                            <Label style="-fx-font-size: 28;" text="🏛" />
                                        </StackPane>
                                        <VBox alignment="CENTER_LEFT" spacing="4">
                                            <Label style="-fx-text-fill: #64748b; -fx-font-size: 13; -fx-font-weight: bold;" text="ĐANG ĐẤU GIÁ" />
                                            <Label fx:id="lblTotalItems" style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #0B1F3A;" text="1,245" />
                                        </VBox>
                                    </children>
                                </HBox>

                                <HBox HBox.hgrow="ALWAYS" prefHeight="110" spacing="20" alignment="CENTER_LEFT"
                                      style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 15, 0, 0, 5);">
                                    <children>
                                        <StackPane prefHeight="60" prefWidth="60" style="-fx-background-color: #ffedd5; -fx-background-radius: 14;">
                                            <Label style="-fx-font-size: 28;" text="🔥" />
                                        </StackPane>
                                        <VBox alignment="CENTER_LEFT" spacing="4">
                                            <Label style="-fx-text-fill: #64748b; -fx-font-size: 13; -fx-font-weight: bold;" text="PHIÊN SÔI NỔI" />
                                            <Label fx:id="lblActiveAuctions" style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #ea580c;" text="89" />
                                        </VBox>
                                    </children>
                                </HBox>

                                <HBox HBox.hgrow="ALWAYS" prefHeight="110" spacing="20" alignment="CENTER_LEFT"
                                      style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 15, 0, 0, 5);">
                                    <children>
                                        <StackPane prefHeight="60" prefWidth="60" style="-fx-background-color: #dcfce7; -fx-background-radius: 14;">
                                            <Label style="-fx-font-size: 28;" text="👥" />
                                        </StackPane>
                                        <VBox alignment="CENTER_LEFT" spacing="4">
                                            <Label style="-fx-text-fill: #64748b; -fx-font-size: 13; -fx-font-weight: bold;" text="THÀNH VIÊN" />
                                            <Label fx:id="lblTotalUsers" style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #16a34a;" text="5,432" />
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <VBox spacing="25" style="-fx-background-color: white; -fx-background-radius: 24; -fx-padding: 35; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 20, 0, 0, 6);">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <VBox spacing="5">
                                            <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #0B1F3A;" text="✨ Sản phẩm đấu giá nổi bật" />
                                            <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 14;" text="Danh sách tài sản đang được trả giá sôi nổi nhất thị trường" />
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 22; -fx-cursor: hand;" text="Xem tất cả tài sản" />
                                    </children>
                                </HBox>

                                <TilePane fx:id="tilePaneProducts" hgap="30" vgap="30" prefColumns="3" style="-fx-background-color: transparent;" />
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>