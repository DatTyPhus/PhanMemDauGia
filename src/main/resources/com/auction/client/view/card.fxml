            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label style="-fx-font-size: 14;" text="Giá hiện tại :">
                     <VBox.margin>
                        <Insets />
                     </VBox.margin></Label>
                  <Label id="currentPrice" text="200" />
