                  <Label id="status" layoutX="14.0" layoutY="14.0" style="-fx-background-color: #22C55E; -fx-background-radius: 6; -fx-padding: 5 10;" text="Đang diên ra" />
               </children></Pane>
         </children>
      </StackPane>
      <VBox prefHeight="200.0" prefWidth="100.0" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10,0,0,2); fxx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-spacing: 12;" styleClass="fx-ef">
         <children>
            <Label id="title" maxWidth="280.0" style="-fx-font-weight: bold; -fx-font-size: 14;" text="Tên sản phẩm" wrapText="true" />
            <Label id="location" style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Địa điểm" />
            <Label id="time" style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="thời gian" />
