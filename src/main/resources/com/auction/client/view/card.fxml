<?import javafx.scene.layout.VBox?>

<VBox maxWidth="275.0" minWidth="300.0" prefHeight="360.0" prefWidth="274.0" spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: s; -fx-border-radius: 12;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <StackPane prefHeight="200.0" prefWidth="200.0">
