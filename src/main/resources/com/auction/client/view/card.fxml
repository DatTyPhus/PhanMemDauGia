<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" prefWidth="290.0" spacing="12.0" style="-fx-background-color: #ffffff; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(148,163,184,0.12), 12, 0, 0, 6);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.CardController">

    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>

    <StackPane prefHeight="160" style="-fx-background-color: linear-gradient(to right bottom, #0f172a, #1e3a8a, #3b82f6); -fx-background-radius: 12 12 0 0; -fx-clip: null;">
        <children>

            <Region maxHeight="150" maxWidth="150" style="-fx-background-color: radial-gradient(center 50% 50%, radius 50%, rgba(255,255,255,0.15) 0%, transparent 100%); -fx-background-radius: 100;" StackPane.alignment="TOP_RIGHT">
                <StackPane.margin>
                    <Insets right="-40" top="-40" />
                </StackPane.margin>
            </Region>

            <Region maxHeight="180" maxWidth="180" style="-fx-background-color: radial-gradient(center 50% 50%, radius 50%, rgba(59,130,246,0.5) 0%, transparent 100%); -fx-background-radius: 100;" StackPane.alignment="BOTTOM_LEFT">
                <StackPane.margin>
                    <Insets bottom="-60" left="-50" />
                </StackPane.margin>
            </Region>

            <VBox alignment="CENTER" spacing="5" StackPane.alignment="CENTER">
                <Label style="-fx-font-size: 38; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 10, 0, 0, 5);" text="💎" />
                <Label style="-fx-text-fill: #e2e8f0; -fx-font-weight: bold; -fx-font-size: 13;" text="TÀI SẢN CAO CẤP" />
            </VBox>

            <ImageView fx:id="image" fitHeight="160.0" fitWidth="258.0" preserveRatio="false" style="-fx-background-radius: 12 12 0 0;" StackPane.alignment="CENTER" />

            <Label fx:id="statusLabel" style="-fx-background-color: rgba(15,23,42,0.8); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11; -fx-padding: 5 10; -fx-background-radius: 20;" text="ĐANG DIỄN RA" StackPane.alignment="TOP_LEFT">
                <StackPane.margin>
                    <Insets left="10.0" top="10.0" />
                </StackPane.margin>
            </Label>

        </children>
    </StackPane>

    <Label fx:id="titleLabel" style="-fx-text-fill: #0f172a; -fx-font-weight: bold; -fx-font-size: 16;" text="Tên xe hoặc máy tính" wrapText="true">
        <VBox.margin>
            <Insets top="2.0" />
        </VBox.margin>
    </Label>

    <VBox spacing="6.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 12; -fx-padding: 10;">
        <children>
            <HBox alignment="CENTER_LEFT">
                <children>
                    <Label style="-fx-text-fill: #64748b; -fx-font-size: 13;" text="Giá hiện tại:" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="priceLabel" style="-fx-text-fill: #10b981; -fx-font-weight: bold; -fx-font-size: 16;" text="0 đ" />
                </children>
            </HBox>

            <Region minHeight="1.0" style="-fx-background-color: #e2e8f0;" />

            <HBox alignment="CENTER_LEFT">
                <children>
                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" text="Giá khởi điểm:" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="startPriceLabel" style="-fx-text-fill: #64748b; -fx-font-weight: semi-bold; -fx-font-size: 13;" text="0 đ" />
                </children>
            </HBox>
        </children>
    </VBox>

    <VBox alignment="CENTER_LEFT" spacing="4.0" style="-fx-background-color: #fff1f2; -fx-background-radius: 8; -fx-padding: 8 12;">
        <children>
            <Label fx:id="startTimeLabel" style="-fx-text-fill: #059669; -fx-font-weight: bold; -fx-font-size: 12;" text="🟢 Bắt đầu: 00:00:00" />
            <Label fx:id="timeLabel" style="-fx-text-fill: #e11d48; -fx-font-weight: bold; -fx-font-size: 12;" text="🔴 Kết thúc: 00:00:00" />
        </children>
    </VBox>

    <Button maxWidth="Infinity" onAction="#onDetailClick" prefHeight="38.0" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13; -fx-background-radius: 10; -fx-cursor: hand;" text="Xem chi tiết">
        <VBox.margin>
            <Insets top="4.0" />
        </VBox.margin>
    </Button>
</VBox>
