<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.EditProduct">
    <top>
        <HBox alignment="CENTER_LEFT" minHeight="75.0" prefHeight="75.0" style="-fx-background-color:#1e293b;">
            <padding>
                <Insets left="30.0" right="30.0" />
            </padding>
            <BorderPane.margin>
                <Insets left="196.0" />
            </BorderPane.margin>
            <children>
                <Label style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;" text="THÊM / SỬA SẢN PHẨM" />
            </children>
        </HBox>
    </top>

    <left>
        <VBox prefHeight="700.0" prefWidth="196.0" style="-fx-background-color: #0B1F3A;" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="196.0">
                    <children>
                        <Label style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" text="🔨">
                            <HBox.margin>
                                <Insets left="15.0" />
                            </HBox.margin>
                        </Label>
                        <VBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="120.0">
                            <children>
                                <Label style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;" text="ĐẤU GIÁ" />
                                <Label style="-fx-text-fill: white; -fx-font-size: 14;" text="TRỰC TUYẾN" />
                            </children>
                            <HBox.margin>
                                <Insets left="10.0" />
                            </HBox.margin>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets bottom="20.0" top="15.0" />
                    </VBox.margin>
                </HBox>

                <Button onAction="#onBackToHomeClick" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Trang chủ">
                    <VBox.margin><Insets left="8" right="8"/></VBox.margin>
                </Button>

                <Button onAction="#onAuctionSessionClick" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Phiên đấu giá">
                    <VBox.margin><Insets left="8" right="8"/></VBox.margin>
                </Button>

                <Button mnemonicParsing="false" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 8;" text="Quản lý tài sản">
                    <VBox.margin><Insets left="8" right="8"/></VBox.margin>
                </Button>

                <Button onAction="#onHistoryClick" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Lịch sử đấu giá">
                    <VBox.margin><Insets left="8" right="8"/></VBox.margin>
                </Button>

                <Button onAction="#onNotificationClick" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Thông báo">
                    <VBox.margin><Insets left="8" right="8"/></VBox.margin>
                </Button>

                <Button onAction="#onProfileClick" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Hồ sơ của tôi">
                    <VBox.margin><Insets left="8" right="8"/></VBox.margin>
                </Button>

                <Button onAction="#onSettingClick" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Cài đặt">
                    <VBox.margin><Insets left="8" right="8"/></VBox.margin>
                </Button>
            </children>

            <BorderPane.margin>
                <Insets top="-75.0" />
            </BorderPane.margin>
        </VBox>
    </left>

    <!-- CONTENT -->
    <center>
        <HBox alignment="CENTER" spacing="40" style="-fx-background-color: #f1f5f9;"> <padding>
            <Insets bottom="40" left="40" right="40" top="40" />
        </padding>

            <VBox alignment="TOP_CENTER" prefWidth="350" spacing="20"
                  style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 5);">

                <Label style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #0B1F3A;" text="📸 Hình ảnh sản phẩm" />

                <StackPane prefHeight="280" prefWidth="280"
                           style="-fx-border-color: #cbd5e1; -fx-border-width: 2; -fx-border-style: dashed; -fx-background-color: #f8fafc; -fx-border-radius: 12; -fx-background-radius: 12;">
                    <children>
                        <ImageView fx:id="imgProduct" fitHeight="260" fitWidth="260" preserveRatio="true" />
                        <Label fx:id="lblUploadText" style="-fx-text-fill: #94a3b8; -fx-font-size: 14;" text="Kéo thả hoặc bấm nút bên dưới" />
                    </children>
                </StackPane>

                <Button maxWidth="Infinity" onAction="#onChooseImageClick"
                        style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 10; -fx-cursor: hand;" text="CHỌN ẢNH TỪ MÁY" />
            </VBox>

            <VBox prefWidth="550" spacing="15"
                  style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 5);">

                <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #0B1F3A;" text="📝 Thông tin chi tiết tài sản" />

                <VBox spacing="5">
                    <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold;" text="Tên sản phẩm" />
                    <TextField fx:id="txtProductName" prefHeight="40" promptText="Ví dụ: iPhone 16 Pro Max 512GB..."
                               style="-fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-padding: 8;" />
                </VBox>

                <HBox spacing="15">
                    <VBox HBox.hgrow="ALWAYS" spacing="5">
                        <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold;" text="Danh mục" />
                        <ComboBox fx:id="cbCategory" maxWidth="Infinity" prefHeight="40"
                                  style="-fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-color: white;" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="5">
                        <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold;" text="Thời lượng" />
                        <ComboBox fx:id="cbDuration" maxWidth="Infinity" prefHeight="40"
                                  style="-fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-color: white;" />
                    </VBox>
                </HBox>

                <HBox spacing="15">
                    <VBox HBox.hgrow="ALWAYS" spacing="5">
                        <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold;" text="Giá khởi điểm (VNĐ)" />
                        <TextField fx:id="txtStartPrice" prefHeight="40" promptText="VD: 25.000.000"
                                   style="-fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-padding: 8;" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="5">
                        <Label style="-fx-text-fill: #3b82f6; -fx-font-weight: bold;" text="Thông tin đặc biệt" />
                        <TextField fx:id="txtSpecialInfo" prefHeight="40" promptText="VD: Fullbox, Có chữ ký..."
                                   style="-fx-background-radius: 8; -fx-border-color: #3b82f6; -fx-border-radius: 8; -fx-padding: 8;" />
                    </VBox>
                </HBox>

                <VBox spacing="5">
                    <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold;" text="Mô tả sản phẩm" />
                    <TextArea fx:id="txtDescription" prefHeight="100" promptText="Nhập mô tả chi tiết về tình trạng tài sản..."
                              style="-fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-padding: 8;" wrapText="true" />
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="15">
                    <VBox.margin><Insets top="10" /></VBox.margin>
                    <Button onAction="#onCancelClick" prefHeight="40" prefWidth="120"
                            style="-fx-background-color: transparent; -fx-text-fill: #ef4444; -fx-border-color: #ef4444; -fx-border-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;" text="HỦY BỎ" />
                    <Button onAction="#onSaveClick" prefHeight="40" prefWidth="160"
                            style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(34,197,94,0.3), 10, 0, 0, 5);" text="LƯU TÀI SẢN" />
                </HBox>
            </VBox>
        </HBox>
    </center>


</BorderPane>
