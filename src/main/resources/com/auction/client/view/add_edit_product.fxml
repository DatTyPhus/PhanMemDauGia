<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.EditProduct">
    <top>
        <HBox alignment="CENTER_LEFT" minHeight="75.0" prefHeight="75.0" style="-fx-background-color:#1e293b;">
            <padding>
                <Insets left="30.0" right="30.0" />
            </padding>
            <BorderPane.margin>
                <Insets left="196.0" />
            </BorderPane.margin>
            <children>
                <Label style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;" text="THÊM / SỬA SẢN PHẨM" />
            </children>
        </HBox>
    </top>

    <left>
        <VBox prefHeight="700.0" prefWidth="196.0" style="-fx-background-color: #0B1F3A;" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="196.0">
                    <children>
                        <Label style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" text="🔨">
                            <HBox.margin>
                                <Insets left="15.0" />
                            </HBox.margin>
                        </Label>
                        <VBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="120.0">
                            <children>
                                <Label style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;" text="ĐẤU GIÁ" />
                                <Label style="-fx-text-fill: white; -fx-font-size: 14;" text="TRỰC TUYẾN" />
                            </children>
                            <HBox.margin>
                                <Insets left="10.0" />
                            </HBox.margin>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets bottom="20.0" top="15.0" />
                    </VBox.margin>
                </HBox>

                <Button mnemonicParsing="false" onAction="#onBackToHomeClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Trang chủ" />
                <Button mnemonicParsing="false" onAction="#onAuctionSessionClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Phiên đấu giá" />
                <Button mnemonicParsing="false" onAction="#onProductManagementClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Quản lý tài sản" />
                <Button mnemonicParsing="false" onAction="#onHistoryClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Lịch sử đấu giá" />
                <Button mnemonicParsing="false" onAction="#onNotificationClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Thông báo" />
                <Button mnemonicParsing="false" onAction="#onProfileClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Hồ sơ của tôi" />
                <Button mnemonicParsing="false" onAction="#onSettingClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Cài đặt" />
            </children>

            <BorderPane.margin>
                <Insets top="-75.0" />
            </BorderPane.margin>
        </VBox>
    </left>

    <!-- CONTENT -->
    <center>
        <HBox spacing="20">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <!-- LEFT: IMAGE -->
            <VBox spacing="10">

                <Label text="Hình ảnh sản phẩm" />

                <StackPane prefHeight="250" prefWidth="250" style="-fx-border-color:#cbd5e1; -fx-border-style:dashed;">
                    <children>
                        <ImageView fitHeight="200" fitWidth="200" preserveRatio="true" />
                        <Label text="+ Upload" />
                    </children>
                </StackPane>

                <Button maxWidth="Infinity" text="Chọn ảnh" />
            <HBox.margin>
               <Insets />
            </HBox.margin>

            </VBox>

            <!-- RIGHT: FORM -->
            <VBox prefWidth="400" spacing="10">

                <Label text="Tên sản phẩm" />
                <TextField />

                <Label text="Danh mục" />
                <ComboBox />

                <Label text="Giá khởi điểm" />
                <TextField />

                <Label text="Bước giá" />
                <TextField />

                <Label text="Ngày bắt đầu" />
                <DatePicker />

                <Label text="Giờ bắt đầu" />
                <TextField promptText="HH:mm" />

                <Label text="Ngày kết thúc" />
                <DatePicker />

                <Label text="Giờ kết thúc" />
                <TextField promptText="HH:mm" />

                <Label text="Mô tả" />
                <TextArea prefHeight="100" />

                <HBox spacing="10">
                    <Button maxWidth="Infinity" style="-fx-background-color:#ef4444; -fx-text-fill:white;" text="HỦY" />

                    <Button maxWidth="Infinity" style="-fx-background-color:#22c55e; -fx-text-fill:white;" text="LƯU" />
                </HBox>

            </VBox>
         <BorderPane.margin>
            <Insets top="-2.0" />
         </BorderPane.margin>

        </HBox>
    </center>

</BorderPane>
