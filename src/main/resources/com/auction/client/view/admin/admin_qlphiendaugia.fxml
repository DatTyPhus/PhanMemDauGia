<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800" prefWidth="1400" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.adminController.Auction">

    <top>
        <HBox alignment="CENTER_LEFT" minHeight="90.0" prefHeight="90.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 5);" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="30.0" right="40.0" />
            </padding>
            <BorderPane.margin>
                <Insets left="196.0" />
            </BorderPane.margin>
            <children>

                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0B1F3A; -fx-letter-spacing: 1;" text="QUẢN LÝ PHIÊN ĐẤU GIÁ" />
                    <HBox alignment="CENTER_LEFT" spacing="5">
                        <Label style="-fx-text-fill: #3b82f6; -fx-font-weight: bold; -fx-font-size: 13;" text="Admin Dashboard" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 13;" text="• Theo dõi và điều hành tất cả các phiên đấu giá trên hệ thống" />
                    </HBox>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER" spacing="15" style="-fx-background-color: #f8fafc; -fx-padding: 8 20; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12;">
                    <children>
                        <VBox alignment="CENTER_RIGHT">
                            <Label fx:id="lblUserName" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Administrator" />
                            <Label fx:id="lblUserRole" style="-fx-font-size: 11; -fx-font-weight: 800; -fx-text-fill: #3b82f6; -fx-background-color: #dbeafe; -fx-padding: 2 8; -fx-background-radius: 4;" text="ADMIN">
                                <VBox.margin>
                                    <Insets right="25.0" top="3.0" />
                                </VBox.margin>
                            </Label>
                        </VBox>
                        <StackPane prefHeight="45" prefWidth="45" style="-fx-background-color: #3b82f6; -fx-background-radius: 10;">
                            <children>
                                <Label style="-fx-font-size: 22; -fx-text-fill: white;" text="👤" />
                            </children>
                        </StackPane>
                    </children>
                </HBox>
            </children>
        </HBox>
    </top>

    <left>
        <VBox prefHeight="700.0" prefWidth="196.0" style="-fx-background-color: #0B1F3A;" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="196.0">
                    <children>
                        <Label style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" text="🔨">
                            <HBox.margin><Insets left="15.0" /></HBox.margin>
                        </Label>
                        <VBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="120.0">
                            <children>
                                <Label style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;" text="ĐẤU GIÁ" />
                                <Label style="-fx-text-fill: white; -fx-font-size: 14;" text="TRỰC TUYẾN" />
                            </children>
                            <HBox.margin><Insets left="10.0" /></HBox.margin>
                        </VBox>
                    </children>
                    <VBox.margin><Insets bottom="20.0" top="15.0" /></VBox.margin>
                </HBox>

                <Button onAction="#onBackHomeClick" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Trang chủ">
                    <VBox.margin><Insets left="8" right="8"/></VBox.margin>
                </Button>

                <Button mnemonicParsing="false" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 8;" text="Phiên đấu giá">
                    <VBox.margin><Insets left="8" right="8"/></VBox.margin>
                </Button>

                <Button onAction="#onHistoryClick" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20;" text="Lịch sử đấu giá">
                    <VBox.margin><Insets left="8" right="8"/></VBox.margin>
                </Button>

                <Button onAction="#onUsersManagementClick" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Quản lý người dùng">
                    <VBox.margin><Insets left="8" right="8"/></VBox.margin>
                </Button>

                <Button onAction="#onProductManagementClick" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Quản lý sản phẩm">
                    <VBox.margin><Insets left="8" right="8"/></VBox.margin>
                </Button>

                <Button onAction="#onSettingClick" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Cài đặt">
                    <VBox.margin><Insets left="8" right="8"/></VBox.margin>
                </Button>
            </children>
            <BorderPane.margin>
                <Insets top="-90.0" />
            </BorderPane.margin>
        </VBox>
    </left>

    <center>
        <VBox spacing="0" style="-fx-background-color: linear-gradient(to bottom, #f8fafc 0%, #e2e8f0 60%, #cbd5e1 100%);">
            <padding>
                <Insets bottom="25" left="30" right="30" top="30" />
            </padding>

            <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="10" style="-fx-background-color: white; -fx-background-radius: 15 15 0 0; -fx-padding: 0 25; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
                <children>
                    <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #475569; -fx-padding: 0 15 0 0;" text="Danh sách phiên đấu giá" />

                    <Button prefHeight="34" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 0 20; -fx-cursor: hand;" text="Tất cả" />
                    <Button prefHeight="34" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 20; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 0 20; -fx-cursor: hand;" text="Đang diễn ra" />
                    <Button prefHeight="34" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 20; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 0 20; -fx-cursor: hand;" text="Sắp diễn ra" />
                    <Button prefHeight="34" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 20; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 0 20; -fx-cursor: hand;" text="Đã kết thúc" />

                    <Region HBox.hgrow="ALWAYS" />

                    <TextField prefHeight="38" prefWidth="250" promptText="🔍 Tìm ID hoặc Tên sản phẩm..." style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0; -fx-padding: 8 15;" />
                    <Button prefHeight="38" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 0 20; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(59,130,246,0.3), 5, 0, 0, 3);" text="+ TẠO PHIÊN MỚI">
                        <HBox.margin>
                            <Insets left="5.0" />
                        </HBox.margin>
                    </Button>
                </children>
            </HBox>

            <VBox style="-fx-background-color: white; -fx-background-radius: 0 0 15 15; -fx-padding: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 10, 0);" VBox.vgrow="ALWAYS">
                <children>
                    <TableView fx:id="auctionTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                        <columns>
                            <TableColumn fx:id="idColumn" prefWidth="80" text="ID" />
                            <TableColumn fx:id="nameColumn" prefWidth="300" text="📦 Tên sản phẩm" />
                            <TableColumn fx:id="priceColumn" prefWidth="180" text="💰 Giá hiện tại" />
                            <TableColumn fx:id="statusColumn" prefWidth="150" text="Trạng thái" />
                            <TableColumn fx:id="timeColumn" prefWidth="200" text="⏱ Thời gian" />
                            <TableColumn fx:id="actionColumn" prefWidth="150" text="Thao tác" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </children>
            </VBox>

            <HBox alignment="CENTER" prefHeight="80.0" spacing="8">
                <children>
                    <Button prefHeight="35" prefWidth="35" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="&lt;" />
                    <Button prefHeight="35" prefWidth="35" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="1" />
                    <Button prefHeight="35" prefWidth="35" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="2" />
                    <Button prefHeight="35" prefWidth="35" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="3" />
                    <Label style="-fx-text-fill: #94a3b8; -fx-font-weight: bold; -fx-padding: 0 5;" text="..." />
                    <Button prefHeight="35" prefWidth="35" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="10" />
                    <Button prefHeight="35" prefWidth="35" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="&gt;" />
                </children>
            </HBox>

        </VBox>
    </center>

</BorderPane>
