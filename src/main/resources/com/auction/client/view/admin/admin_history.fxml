<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800" prefWidth="1400" stylesheets="@../sidebar.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.adminController.History">

    <top>
        <HBox alignment="CENTER_LEFT" minHeight="90.0" prefHeight="90.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 5);" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="30.0" right="40.0" />
            </padding>
            <BorderPane.margin>
                <Insets left="196.0" />
            </BorderPane.margin>
            <children>

                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0B1F3A; -fx-letter-spacing: 1;" text="LỊCH SỬ ĐẤU GIÁ" />
                    <HBox alignment="CENTER_LEFT" spacing="5">
                        <Label style="-fx-text-fill: #3b82f6; -fx-font-weight: bold; -fx-font-size: 13;" text="Admin Dashboard" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 13;" text="• Theo dõi toàn bộ phiên đấu giá đã kết thúc trên hệ thống" />
                    </HBox>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER" spacing="15" style="-fx-background-color: #f8fafc; -fx-padding: 8 20; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12;">
                    <VBox alignment="CENTER_RIGHT">
                        <Label fx:id="lblUserName" style="-fx-font-weight: bold; -fx-font-size: 15; -fx-text-fill: #1e293b;" text="Administrator" />
                        <Label fx:id="lblUserRole" style="-fx-font-weight: 800; -fx-font-size: 11; -fx-text-fill: #3b82f6; -fx-background-color: #dbeafe; -fx-padding: 2 8; -fx-background-radius: 4;" text="ADMIN" />
                    </VBox>
                    <StackPane prefHeight="45" prefWidth="45" style="-fx-background-color: #3b82f6; -fx-background-radius: 10;">
                        <Label style="-fx-font-size: 22; -fx-text-fill: white;" text="👤" />
                    </StackPane>
                </HBox>
            </children>
        </HBox>
    </top>

    <left>
        <VBox prefHeight="700.0" prefWidth="196.0" style="-fx-background-color: #0B1F3A;" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="196.0">
                    <children>
                  <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../image/54699acc-6fba-4ff0-b214-6edb30950a28.png" />
                     </image>
                  </ImageView>
                        <VBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="120.0">
                            <children>
                                <Label style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;" text="ĐẤU GIÁ" />
                                <Label style="-fx-text-fill: white; -fx-font-size: 14;" text="TRỰC TUYẾN" />
                            </children>
                            <HBox.margin><Insets left="10.0" /></HBox.margin>
                        </VBox>
                    </children>
                    <VBox.margin><Insets bottom="20.0" top="15.0" /></VBox.margin>
                </HBox>

                <Button mnemonicParsing="false" onAction="#onBackHomeClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Trang chủ">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>

                <Button mnemonicParsing="false" onAction="#onAuctionSessionClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Phiên đấu giá">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>

                <Button maxWidth="250.0" mnemonicParsing="false" styleClass="nav-btn-active" text="Lịch sử đấu giá">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>

                <Button mnemonicParsing="false" onAction="#onUsersManagementClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Quản lý người dùng">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>

                <Button mnemonicParsing="false" onAction="#onProductManagementClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Quản lý sản phẩm">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>

                <Button mnemonicParsing="false" onAction="#onSettingClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Cài đặt">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>
            </children>
            <BorderPane.margin>
                <Insets top="-90.0" />
            </BorderPane.margin>
        </VBox>
    </left>

    <center>
        <VBox spacing="0" style="-fx-background-color: linear-gradient(to bottom, #f8fafc 0%, #e2e8f0 60%, #cbd5e1 100%);">
            <padding>
                <Insets bottom="25" left="30" right="30" top="30" />
            </padding>

            <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="10" style="-fx-background-color: white; -fx-background-radius: 15 15 0 0; -fx-padding: 0 25; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
                <children>
                    <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Danh sách phiên đấu giá thành công" />

                    <Region HBox.hgrow="ALWAYS" />
                </children>
            </HBox>

            <VBox style="-fx-background-color: white; -fx-background-radius: 0 0 15 15; -fx-padding: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 10, 0);" VBox.vgrow="ALWAYS">
                <children>
                    <TableView style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn prefWidth="120" text="Mã phiên" />
                            <TableColumn prefWidth="350" text="📦 Tên sản phẩm" />
                            <TableColumn prefWidth="250" text="👤 Người thắng" />
                            <TableColumn prefWidth="200" text="💰 Giá cuối (VNĐ)" />
                            <TableColumn prefWidth="200" text="📅 Ngày kết thúc" />
                            <TableColumn prefWidth="150" text="Trạng thái" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </children>
            </VBox>

            <HBox alignment="CENTER" prefHeight="80.0" spacing="8">
                <children>
                    <Button prefHeight="35" prefWidth="35" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="&lt;" />
                    <Button prefHeight="35" prefWidth="35" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="1" />
                    <Button prefHeight="35" prefWidth="35" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="2" />
                    <Button prefHeight="35" prefWidth="35" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="3" />
                    <Label style="-fx-text-fill: #94a3b8; -fx-font-weight: bold; -fx-padding: 0 5;" text="..." />
                    <Button prefHeight="35" prefWidth="35" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="12" />
                    <Button prefHeight="35" prefWidth="35" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="&gt;" />
                </children>
            </HBox>

        </VBox>
    </center>

</BorderPane>
