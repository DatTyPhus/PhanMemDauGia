<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800" prefWidth="1400" style="-fx-background-color: #f1f5f9;" stylesheets="@../sidebar.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.adminController.Home">

    <top>
        <HBox alignment="CENTER_LEFT" minHeight="90.0" prefHeight="90.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="30" right="40" />
            </padding>
            <BorderPane.margin>
                <Insets left="196.0" />
            </BorderPane.margin>

            <VBox alignment="CENTER_LEFT" spacing="5">
                <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0B1F3A; -fx-letter-spacing: 1;" text="HỆ THỐNG ĐẤU GIÁ" />
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <Label style="-fx-text-fill: #22c55e; -fx-font-weight: bold; -fx-font-size: 13;" text="● LIVE" />
                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 13;" text=" | Trung tâm điều hành quản trị viên" />
                </HBox>
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER" spacing="15" style="-fx-background-color: #f8fafc; -fx-padding: 8 20; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12;">
                <VBox alignment="CENTER_RIGHT">
                    <Label fx:id="lblUserName" style="-fx-font-weight: bold; -fx-font-size: 15; -fx-text-fill: #1e293b;" text="Administrator" />
                    <Label fx:id="lblUserRole" style="-fx-font-weight: 800; -fx-font-size: 11; -fx-text-fill: #3b82f6; -fx-background-color: #dbeafe; -fx-padding: 2 8; -fx-background-radius: 4;" text="ADMIN" />
                </VBox>
                <StackPane prefHeight="45" prefWidth="45" style="-fx-background-color: #3b82f6; -fx-background-radius: 10;">
                    <Label style="-fx-font-size: 22; -fx-text-fill: white;" text="👤" />
                </StackPane>
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox prefHeight="700.0" prefWidth="196.0" style="-fx-background-color: #0B1F3A;" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="196.0">
                    <children>
                  <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../image/54699acc-6fba-4ff0-b214-6edb30950a28.png" />
                     </image>
                  </ImageView>
                        <VBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="120.0">
                            <children>
                                <Label style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;" text="ĐẤU GIÁ" />
                                <Label style="-fx-text-fill: white; -fx-font-size: 14;" text="TRỰC TUYẾN" />
                            </children>
                            <HBox.margin><Insets left="10.0" /></HBox.margin>
                        </VBox>
                    </children>
                    <VBox.margin><Insets bottom="20.0" top="15.0" /></VBox.margin>
                </HBox>

                <Button maxWidth="250.0" mnemonicParsing="false" styleClass="nav-btn-active" text="Trang chủ">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>

                <Button mnemonicParsing="false" onAction="#onAuctionSessionClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Phiên đấu giá">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>

                <Button mnemonicParsing="false" onAction="#onHistoryClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20;" styleClass="nav-btn" text="Lịch sử đấu giá">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>

                <Button mnemonicParsing="false" onAction="#onUsersManagementClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Quản lý người dùng">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>

                <Button mnemonicParsing="false" onAction="#onProductManagementClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Quản lý sản phẩm">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>

                <Button mnemonicParsing="false" onAction="#onSettingClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Cài đặt">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>
            </children>
            <BorderPane.margin>
                <Insets top="-90.0" />
            </BorderPane.margin>
        </VBox>
    </left>

    <center>
        <VBox spacing="30" style="-fx-padding: 40; -fx-background-color: #f1f5f9;">

            <VBox spacing="8">
                <Label style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Tổng quan hệ thống" />
                <Label style="-fx-font-size: 15; -fx-text-fill: #64748b;" text="Theo dõi và kiểm duyệt toàn bộ hoạt động trên sàn đấu giá." />
            </VBox>

            <HBox spacing="25">
                <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="20" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 15, 0, 0, 5);" HBox.hgrow="ALWAYS">
                    <StackPane prefHeight="65" prefWidth="65" style="-fx-background-color: #dbeafe; -fx-background-radius: 14;">
                        <Label style="-fx-font-size: 28; -fx-text-fill: #3b82f6;" text="📦" />
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="2">
                        <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold; -fx-font-size: 14;" text="TỔNG TÀI SẢN" />
                        <Label fx:id="lblTotalProducts" style="-fx-font-size: 28; -fx-font-weight: 900; -fx-text-fill: #0f172a;" text="156" />
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="20" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 15, 0, 0, 5);" HBox.hgrow="ALWAYS">
                    <StackPane prefHeight="65" prefWidth="65" style="-fx-background-color: #fef3c7; -fx-background-radius: 14;">
                        <Label style="-fx-font-size: 28; -fx-text-fill: #d97706;" text="🔥" />
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="2">
                        <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold; -fx-font-size: 14;" text="PHIÊN ĐẤU GIÁ" />
                        <Label fx:id="lblTotalAuctions" style="-fx-font-size: 28; -fx-font-weight: 900; -fx-text-fill: #0f172a;" text="24" />
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="20" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 15, 0, 0, 5);" HBox.hgrow="ALWAYS">
                    <StackPane prefHeight="65" prefWidth="65" style="-fx-background-color: #dcfce7; -fx-background-radius: 14;">
                        <Label style="-fx-font-size: 28; -fx-text-fill: #16a34a;" text="👥" />
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="2">
                        <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold; -fx-font-size: 14;" text="NGƯỜI DÙNG" />
                        <Label fx:id="lblTotalUsers" style="-fx-font-size: 28; -fx-font-weight: 900; -fx-text-fill: #0f172a;" text="3,102" />
                    </VBox>
                </HBox>
            </HBox>

            <HBox spacing="25" VBox.vgrow="ALWAYS">
                <VBox maxWidth="Infinity" spacing="20" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 15, 0, 0, 5);" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="⚡ Lối tắt nghiệp vụ" />
                    <Label style="-fx-text-fill: #64748b; -fx-font-size: 14;" text="Xử lý nhanh các yêu cầu đang tồn đọng trên hệ thống." />

                    <HBox spacing="20" style="-fx-padding: 10 0 0 0;">
                        <Button maxWidth="Infinity" onAction="#onProductManagementClick" prefHeight="100" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 20;" HBox.hgrow="ALWAYS">
                            <graphic>
                                <VBox spacing="5">
                                    <Label style="-fx-font-size: 24;" text="📝" />
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Duyệt sản phẩm mới" />
                                </VBox>
                            </graphic>
                        </Button>

                        <Button maxWidth="Infinity" onAction="#onUsersManagementClick" prefHeight="100" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 20;" HBox.hgrow="ALWAYS">
                            <graphic>
                                <VBox spacing="5">
                                    <Label style="-fx-font-size: 24;" text="🔐" />
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Quản lý tài khoản" />
                                </VBox>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>

                <VBox alignment="CENTER" minWidth="350" prefWidth="400" spacing="15" style="-fx-background-color: linear-gradient(to bottom right, #1e293b, #0f172a); -fx-background-radius: 16; -fx-padding: 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 20, 0, 0, 10);">
                    <Label style="-fx-font-size: 40;" text="🛡️" />
                    <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: white;" text="Bảo vệ sự minh bạch" />
                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 14; -fx-alignment: center;" text="Hệ thống đang hoạt động ổn định. Vai trò của bạn giúp nền tảng luôn công bằng và an toàn." textAlignment="CENTER" wrapText="true" />
                </VBox>
            </HBox>

        </VBox>
    </center>
</BorderPane>
