<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1280.0" stylesheets="@sidebar.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.ProductManageController">
    <top>
        <HBox alignment="CENTER_LEFT" minHeight="90.0" prefHeight="90.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 5);" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="30.0" right="40.0" />
            </padding>
            <BorderPane.margin>
                <Insets left="196.0" />
            </BorderPane.margin>
            <children>
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0B1F3A; -fx-letter-spacing: 1;" text="QUẢN LÝ TÀI SẢN" />
                    <HBox alignment="CENTER_LEFT" spacing="5">
                        <Label style="-fx-text-fill: #3b82f6; -fx-font-weight: bold; -fx-font-size: 13;" text="Seller Dashboard" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 13;" text="• Theo dõi và cập nhật sản phẩm" />
                    </HBox>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER" spacing="15" style="-fx-background-color: #f8fafc; -fx-padding: 8 20; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12;">
                    <children>
                        <VBox alignment="CENTER_RIGHT" spacing="2">
                            <Label fx:id="lblUserName" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Tên Người Dùng" />
                            <HBox alignment="CENTER_RIGHT" spacing="8">
                                <Label fx:id="lblTopBalance" style="-fx-text-fill: #10b981; -fx-font-weight: bold; -fx-font-size: 12;" text="Số dư: 0 VNĐ" />
                                <Label fx:id="lblUserRole" style="-fx-font-size: 11; -fx-font-weight: 800; -fx-text-fill: #3b82f6; -fx-background-color: #dbeafe; -fx-padding: 2 8; -fx-background-radius: 4;" text="ROLE" />
                            </HBox>
                        </VBox>
                        <StackPane prefHeight="45" prefWidth="45" style="-fx-background-color: #3b82f6; -fx-background-radius: 10;">
                            <children>
                                <Label style="-fx-font-size: 22; -fx-text-fill: white;" text="👤" />
                            </children>
                        </StackPane>
                    </children>
                </HBox>
            </children>
        </HBox>
    </top>

    <left>
        <VBox prefHeight="700.0" prefWidth="196.0" style="-fx-background-color: #0B1F3A;" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="196.0">
                    <children>
                  <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../image/54699acc-6fba-4ff0-b214-6edb30950a28.png" />
                     </image></ImageView>
                        <VBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="120.0">
                            <children>
                                <Label style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;" text="ĐẤU GIÁ" />
                                <Label style="-fx-text-fill: white; -fx-font-size: 14;" text="TRỰC TUYẾN" />
                            </children>
                            <HBox.margin>
                                <Insets left="10.0" />
                            </HBox.margin>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets bottom="20.0" top="15.0" />
                    </VBox.margin>
                </HBox>

                <Button mnemonicParsing="false" onAction="#onBackToHomeClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Trang chủ">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>

                <Button mnemonicParsing="false" onAction="#onAuctionSessionClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Phiên đấu giá">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>

                <Button maxWidth="250.0" mnemonicParsing="false" prefHeight="47.0" prefWidth="180.0" styleClass="nav-btn-active" text="Quản lý tài sản">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>

                <Button mnemonicParsing="false" onAction="#onHistoryClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Lịch sử đấu giá">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>

                <Button mnemonicParsing="false" onAction="#onNotificationClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Thông báo">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>

                <Button mnemonicParsing="false" onAction="#onProfileClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Hồ sơ của tôi">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>

                <Button mnemonicParsing="false" onAction="#onSettingClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Cài đặt">
                    <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                </Button>
            </children>

            <BorderPane.margin>
                <Insets top="-90.0" />
            </BorderPane.margin>
        </VBox>
    </left>

    <!-- MAIN -->
    <center>
        <VBox spacing="0" style="-fx-background-color: linear-gradient(to bottom, #f8fafc 0%, #e2e8f0 60%, #cbd5e1 100%);">
            <padding>
                <Insets bottom="25" left="30" right="30" top="30" />
            </padding>

            <HBox alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-background-color: white; -fx-background-radius: 15 15 0 0; -fx-padding: 0 25; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
                <children>
                    <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Danh mục tài sản đang đấu giá" />
                    <Region HBox.hgrow="ALWAYS" />
               <ButtonBar prefHeight="40.0" prefWidth="200.0">
                 <buttons>
                     <Button onAction="#onRefreshClick" mnemonicParsing="false" style="-fx-effect: dropshadow(three-pass-box, rgba(59,130,246,0.4), 8, 0, 0, 4); -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8; -fx-text-fill: white; -fx-background-color: #3b82f6;" text="+ LÀM MỚI">                        <padding>
                           <Insets bottom="11.0" left="15.0" right="15.0" top="11.0" />
                        </padding></Button>
                 </buttons>
               </ButtonBar>
                    <Button onAction="#handleAdd" prefHeight="40" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(59,130,246,0.4), 8, 0, 0, 4);" text="+ THÊM SẢN PHẨM">
                  <HBox.margin>
                     <Insets left="11.0" />
                  </HBox.margin></Button>
                </children>
            </HBox>

            <VBox style="-fx-background-color: white; -fx-background-radius: 0 0 15 15; -fx-padding: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 10, 0);">
                <children>
                    <TableView fx:id="productTable" prefHeight="480.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 10;">
                        <columns>
                            <TableColumn fx:id="colName" prefWidth="180" text="📦 Sản phẩm" />
                            <TableColumn fx:id="colType" prefWidth="100" text="Loại" />
                            <TableColumn fx:id="colDescription" prefWidth="200" text="Mô tả" />
                            <TableColumn fx:id="colSpecialInfo" prefWidth="130" text="Thông tin đặc biệt" />
                            <TableColumn fx:id="colPrice" prefWidth="150" text="Giá tiền" />
                            <TableColumn fx:id="colDuration" prefWidth="90" text="⏱ Hạn" />
                            <TableColumn fx:id="colStatus" prefWidth="120" text="Trạng thái" />
                            <TableColumn fx:id="colAction" prefWidth="130" text="Thao tác" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </children>
            </VBox>

            <HBox alignment="CENTER" prefHeight="80.0">
                <children>
                    <Pagination fx:id="pagination" maxPageIndicatorCount="5" pageCount="10" prefWidth="500" style="-fx-page-information-visible: false; -fx-bullet-button-size: 0; -fx-arrow-button-size: 0;" />
                </children>
            </HBox>
        </VBox>
    </center>

</BorderPane>
