<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800" prefWidth="1400" style="-fx-background-color: #f1f5f9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.AuctionController">

    <top>
        <HBox alignment="CENTER_LEFT" minHeight="90.0" prefHeight="90.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 5);" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="30.0" right="40.0" />
            </padding>
            <BorderPane.margin>
                <Insets left="196.0" />
            </BorderPane.margin>
            <children>
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0B1F3A; -fx-letter-spacing: 1;" text="PHIÊN ĐẤU GIÁ" />
                    <HBox alignment="CENTER_LEFT" spacing="5">
                        <Label style="-fx-text-fill: #3b82f6; -fx-font-weight: bold; -fx-font-size: 13;" text="SÀN GIAO DỊCH" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 13;" text=" | Khám phá và tham gia trả giá tài sản" />
                    </HBox>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER" spacing="15" style="-fx-background-color: #f8fafc; -fx-padding: 8 20; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12;">
                    <children>
                        <VBox alignment="CENTER_RIGHT">
                            <Label fx:id="lblUserName" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Tên Người Dùng" />
                            <Label fx:id="lblUserRole" style="-fx-font-size: 11; -fx-font-weight: 800; -fx-text-fill: #3b82f6; -fx-background-color: #dbeafe; -fx-padding: 2 8; -fx-background-radius: 4;" text="ROLE" />
                        </VBox>
                        <StackPane prefHeight="45" prefWidth="45" style="-fx-background-color: #3b82f6; -fx-background-radius: 10;">
                            <children>
                                <Label style="-fx-font-size: 22; -fx-text-fill: white;" text="👤" />
                            </children>
                        </StackPane>
                    </children>
                </HBox>
            </children>
        </HBox>
    </top>

    <left>
        <VBox prefHeight="700.0" prefWidth="196.0" style="-fx-background-color: #0B1F3A;" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="196.0">
                    <children>
                        <Label style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" text="🔨">
                            <HBox.margin><Insets left="15.0" /></HBox.margin>
                        </Label>
                        <VBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="120.0">
                            <children>
                                <Label style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;" text="ĐẤU GIÁ" />
                                <Label style="-fx-text-fill: white; -fx-font-size: 14;" text="TRỰC TUYẾN" />
                            </children>
                            <HBox.margin><Insets left="10.0" /></HBox.margin>
                        </VBox>
                    </children>
                    <VBox.margin><Insets bottom="20.0" top="15.0" /></VBox.margin>
                </HBox>

                <Button onAction="#onBackToHomeClick" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Trang chủ">
                    <VBox.margin><Insets left="8" right="8"/></VBox.margin>
                </Button>
                <Button mnemonicParsing="false" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 8;" text="Phiên đấu giá">
                    <VBox.margin><Insets left="8" right="8"/></VBox.margin>
                </Button>
                <Button onAction="#onProductManagementClick" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Quản lý tài sản">
                    <VBox.margin><Insets left="8" right="8"/></VBox.margin>
                </Button>
                <Button onAction="#onHistoryClick" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Lịch sử đấu giá">
                    <VBox.margin><Insets left="8" right="8"/></VBox.margin>
                </Button>
                <Button onAction="#onNotificationClick" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Thông báo">
                    <VBox.margin><Insets left="8" right="8"/></VBox.margin>
                </Button>
                <Button onAction="#onProfileClick" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Hồ sơ của tôi">
                    <VBox.margin><Insets left="8" right="8"/></VBox.margin>
                </Button>
                <Button onAction="#onSettingClick" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Cài đặt">
                    <VBox.margin><Insets left="8" right="8"/></VBox.margin>
                </Button>
            </children>
            <BorderPane.margin>
                <Insets top="-90.0" />
            </BorderPane.margin>
        </VBox>
    </left>

    <center>
        <VBox spacing="25" style="-fx-background-color: linear-gradient(to bottom right, #ffffff 0%, #f1f5f9 40%, #e2e8f0 100%);">
            <padding>
                <Insets bottom="25" left="35" right="35" top="35" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: white; -fx-padding: 15 25; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 3);">
                <Label style="-fx-font-weight: bold; -fx-font-size: 15; -fx-text-fill: #475569;" text="Trạng thái:" />

                <HBox spacing="10">
                    <Button onAction="#filterAll" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;" text="Tất cả" />
                    <Button onAction="#filterRunning" style="-fx-background-color: transparent; -fx-border-color: #cbd5e1; -fx-border-radius: 20; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand;" text="Đang diễn ra" />
                    <Button onAction="#filterUpcoming" style="-fx-background-color: transparent; -fx-border-color: #cbd5e1; -fx-border-radius: 20; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand;" text="Sắp diễn ra" />
                    <Button onAction="#filterFinished" style="-fx-background-color: transparent; -fx-border-color: #cbd5e1; -fx-border-radius: 20; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand;" text="Đã kết thúc" />
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <Label style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #475569;" text="Sắp xếp:" />
                <ComboBox promptText="Mới nhất" style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-radius: 8;" prefHeight="38" prefWidth="150" />
            </HBox>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                <content>
                    <TilePane fx:id="cardContainer" hgap="30" vgap="30" prefColumns="4" style="-fx-background-color: transparent;">
                        <padding>
                            <Insets bottom="20" left="10" right="10" top="10" />
                        </padding>
                    </TilePane>
                </content>
            </ScrollPane>

            <HBox alignment="CENTER" prefHeight="50">
                <Pagination fx:id="pagination" maxPageIndicatorCount="5" prefWidth="400" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
