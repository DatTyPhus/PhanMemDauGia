<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="850" prefWidth="1500" style="-fx-background-color: #f5f7fb;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.ProductReviewController">

      <top>
        <HBox alignment="CENTER_LEFT" minHeight="75.0" prefHeight="75.0" spacing="15" style="-fx-background-color: white; -fx-border-color: #E5EAF2; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets left="30" right="30" />
            </padding>
            <TextField prefHeight="38.0" prefWidth="350.0" promptText="Tìm kiếm tài sản, phiên đấu giá..." style="-fx-border-color: #DDE3EC; -fx-padding: 8 15; -fx-background-radius: 8; -fx-border-radius: 8;" />

            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#onNotificationClick" style="-fx-font-size: 18; -fx-background-color: transparent; -fx-cursor: hand;" text="✉" />
         <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@../avatar.jpg" />
            </image>
         </ImageView>
            <VBox alignment="CENTER_LEFT" prefHeight="75.0">
                <Label fx:id="lblUserName" style="-fx-font-weight: bold; -fx-font-size: 14;" text="Nguyễn Văn A" />

                <Label fx:id="lblUserRole" style="-fx-text-fill: gray; -fx-font-size: 12;" text="Admin" />
            </VBox>

            <BorderPane.margin>
            <Insets left="200.0" /> </BorderPane.margin>
        </HBox>
    </top>
    <!-- ================= SIDEBAR ================= -->
    <left>
        <VBox prefHeight="700.0" prefWidth="196.0" style="-fx-background-color: #0B1F3A;" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="196.0">
                    <children>
                        <Label style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" text="🔨">
                            <HBox.margin>
                                <Insets left="15.0" />
                            </HBox.margin>
                        </Label>
                        <VBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="120.0">
                            <children>
                                <Label style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;" text="ĐẤU GIÁ" />
                                <Label style="-fx-text-fill: white; -fx-font-size: 14;" text="TRỰC TUYẾN" />
                            </children>
                            <HBox.margin>
                                <Insets left="10.0" />
                            </HBox.margin>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets bottom="20.0" top="13.0" />
                    </VBox.margin>
                </HBox>

                <Button mnemonicParsing="false" onAction="#onBackToHomeClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Trang chủ" />
                <Button mnemonicParsing="false" onAction="#onAuctionSessionClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Phiên đấu giá" />
                <Button mnemonicParsing="false" onAction="#onNotificationClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Thông báo" />
            <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20;" text="Lịch sử đấu giá" />
                <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Quản lí người dùng" />
                <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Quản lí sản phẩm" />
                <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Hồ sơ của tôi" />
                <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" text="Cài đặt" />
            </children>

            <BorderPane.margin>
                <Insets top="-75.0" />
            </BorderPane.margin>
        </VBox>
    </left>

    <!-- ================= MAIN CONTENT ================= -->

    <center>

        <VBox spacing="20" style="-fx-padding: 25;">

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT">

                <VBox spacing="5">

                    <Label style="-fx-font-size: 30px;                                   -fx-font-weight: bold;" text="Kiểm duyệt sản phẩm" />

                    <Label style="-fx-text-fill: #64748b;" text="Kiểm tra và phê duyệt sản phẩm đấu giá" />

                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <Button prefHeight="40" style="-fx-background-color: #2563eb;                                -fx-text-fill: white;                                -fx-font-weight: bold;                                -fx-background-radius: 10;                                -fx-padding: 0 20;" text="Làm mới" />

            </HBox>

            <!-- FILTER -->
            <HBox spacing="10">

                <TextField prefHeight="36" prefWidth="260" promptText="Tìm kiếm sản phẩm..." style="-fx-background-radius: 8;                                   -fx-border-radius: 8;                                   -fx-border-color: #dbeafe;" />

                <ComboBox prefHeight="36" prefWidth="180" promptText="Trạng thái" />

                <ComboBox prefHeight="36" prefWidth="180" promptText="Danh mục" />

                <Region HBox.hgrow="ALWAYS" />

                <Button prefHeight="36" style="-fx-background-color: #fef3c7;                                -fx-text-fill: #b45309;                                -fx-background-radius: 8;" text="Đang chờ duyệt" />

                <Button prefHeight="36" style="-fx-background-color: #dcfce7;                                -fx-text-fill: #15803d;                                -fx-background-radius: 8;" text="Đã duyệt" />

                <Button prefHeight="36" style="-fx-background-color: #fee2e2;                                -fx-text-fill: #dc2626;                                -fx-background-radius: 8;" text="Từ chối" />

            </HBox>

            <!-- TABLE -->
            <VBox style="-fx-background-color: white;                          -fx-background-radius: 16;                          -fx-border-color: #e2e8f0;                          -fx-border-radius: 16;" VBox.vgrow="ALWAYS">

                <TableView fx:id="reviewTable" VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="idColumn" prefWidth="90" text="ID" />

                        <TableColumn fx:id="productColumn" prefWidth="300" text="Sản phẩm" />

                        <TableColumn fx:id="sellerColumn" prefWidth="220" text="Người đăng" />

                        <TableColumn fx:id="priceColumn" prefWidth="180" text="Giá khởi điểm" />

                        <TableColumn fx:id="dateColumn" prefWidth="180" text="Ngày gửi" />

                        <TableColumn fx:id="statusColumn" prefWidth="234.66650390625" text="Thao tác" />

                    </columns>

                </TableView>

            </VBox>
         <HBox prefHeight="60.0" prefWidth="200.0">
            <children>
               <Pagination prefHeight="100.0" prefWidth="150.0">
                  <HBox.margin>
                     <Insets left="522.0" />
                  </HBox.margin>
               </Pagination>
            </children>
         </HBox>

        </VBox>

    </center>

</BorderPane>
