<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="800.0" prefWidth="1400.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.NotificationController">
    <children>
        <BorderPane style="-fx-background-color: #f1f5f9;" stylesheets="@sidebar.css">

            <top>
                <HBox alignment="CENTER_LEFT" minHeight="90.0" prefHeight="90.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 5);" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets left="30.0" right="40.0" />
                    </padding>
                    <BorderPane.margin>
                        <Insets left="196.0" />
                    </BorderPane.margin>
                    <children>
                        <VBox alignment="CENTER_LEFT" spacing="5">
                            <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0B1F3A; -fx-letter-spacing: 1;" text="TRUNG TÂM THÔNG BÁO" />
                            <HBox alignment="CENTER_LEFT" spacing="5">
                                <Label style="-fx-text-fill: #3b82f6; -fx-font-weight: bold; -fx-font-size: 13;" text="CẬP NHẬT" />
                                <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 13;" text=" | Theo dõi hoạt động và phản hồi hệ thống" />
                            </HBox>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER" spacing="15" style="-fx-background-color: #f8fafc; -fx-padding: 8 20; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12;">
                            <children>
                                <VBox alignment="CENTER_RIGHT">
                                    <Label fx:id="lblUserName" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Nguyễn Tiến Đạt" />
                                    <Label fx:id="lblUserRole" style="-fx-font-size: 11; -fx-font-weight: 800; -fx-text-fill: #3b82f6; -fx-background-color: #dbeafe; -fx-padding: 2 8; -fx-background-radius: 4;" text="ROLE" />
                                </VBox>
                                <StackPane prefHeight="45" prefWidth="45" style="-fx-background-color: #3b82f6; -fx-background-radius: 10;">
                                    <children>
                                        <Label style="-fx-font-size: 22; -fx-text-fill: white;" text="👤" />
                                    </children>
                                </StackPane>
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </top>

            <left>
                <VBox prefHeight="700.0" prefWidth="196.0" style="-fx-background-color: #0B1F3A;" BorderPane.alignment="CENTER">
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="196.0">
                            <children>
                        <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../image/54699acc-6fba-4ff0-b214-6edb30950a28.png" />
                           </image>
                        </ImageView>
                                <VBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="120.0">
                                    <children>
                                        <Label style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;" text="ĐẤU GIÁ" />
                                        <Label style="-fx-text-fill: white; -fx-font-size: 14;" text="TRỰC TUYẾN" />
                                    </children>
                                    <HBox.margin><Insets left="10.0" /></HBox.margin>
                                </VBox>
                            </children>
                            <VBox.margin><Insets bottom="20.0" top="15.0" /></VBox.margin>
                        </HBox>

                        <Button mnemonicParsing="false" onAction="#onBackToHomeClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Trang chủ">
                            <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#onAuctionSessionClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Phiên đấu giá">
                            <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#onProductManagementClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Quản lý tài sản">
                            <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#onHistoryClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Lịch sử đấu giá">
                            <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                        </Button>

                        <Button maxWidth="250.0" mnemonicParsing="false" styleClass="nav-btn-active" text="Thông báo">
                            <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                        </Button>

                        <Button mnemonicParsing="false" onAction="#onProfileClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Hồ sơ của tôi">
                            <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#onSettingClick" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12 20; -fx-font-size: 14;" styleClass="nav-btn" text="Cài đặt">
                            <VBox.margin><Insets left="8" right="8" /></VBox.margin>
                        </Button>
                    </children>
                    <BorderPane.margin>
                        <Insets top="-90.0" />
                    </BorderPane.margin>
                </VBox>
            </left>

            <center>
                <VBox spacing="25" style="-fx-background-color: linear-gradient(to bottom right, #ffffff 0%, #f1f5f9 40%, #e2e8f0 100%);">
                    <padding>
                        <Insets bottom="30" left="35" right="35" top="35" />
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: white; -fx-padding: 15 25; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 3);">
                        <Label style="-fx-font-weight: bold; -fx-font-size: 15; -fx-text-fill: #475569;" text="Lọc tin nhắn:" />

                        <HBox spacing="10">
                            <Button style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;" text="Tất cả" />
                            <Button style="-fx-background-color: transparent; -fx-border-color: #cbd5e1; -fx-border-radius: 20; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand;" text="Chưa đọc" />
                            <Button style="-fx-background-color: transparent; -fx-border-color: #cbd5e1; -fx-border-radius: 20; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand;" text="Đã đọc" />
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <Button style="-fx-background-color: transparent; -fx-text-fill: #3b82f6; -fx-font-weight: bold; -fx-cursor: hand;" text="✓ Đánh dấu tất cả là đã đọc" />
                    </HBox>

                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                        <content>
                            <VBox fx:id="notificationList" spacing="15" style="-fx-background-color: transparent;">
                                <padding>
                                    <Insets bottom="20" left="5" right="15" top="5" />
                                </padding>
                            </VBox>
                        </content>
                    </ScrollPane>
                </VBox>
            </center>

        </BorderPane>

        <VBox fx:id="toastBox" managed="false" maxWidth="350" spacing="12" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 20, 0, 0, 10);" visible="false" StackPane.alignment="TOP_RIGHT">

            <StackPane.margin>
                <Insets right="30.0" top="30.0" />
            </StackPane.margin>

            <children>
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <children>

                        <StackPane prefHeight="45.0" prefWidth="45.0" style="-fx-background-color: #dbeafe; -fx-background-radius: 10;">
                            <children>
                                <Label style="-fx-font-size: 20;" text="🔔" />
                            </children>
                        </StackPane>

                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="toastTitle" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Thông báo mới" />
                                <Label fx:id="toastMessage" style="-fx-text-fill: #64748b; -fx-font-size: 13;" text="Bạn có một tin nhắn mới từ hệ thống." wrapText="true" />
                            </children>
                        </VBox>

                    </children>
                </HBox>
            </children>

        </VBox>
      <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />

    </children>
</StackPane>
